rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /players/{uid}/inbox/{id} {
      allow create: if signedIn();
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }
    match /master/{id} { allow read: if true; allow write: if signedIn(); }
    match /meta/{id}   { allow read, write: if signedIn(); }
    match /bots/{id}   { allow read, write: if signedIn(); }
    match /race/{key}  { allow read, write: if signedIn(); }
    match /market/{id} { allow read, write: if signedIn(); }
  }
}
